{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DartNative: Attach to Dev Server",
      "type": "dartnative",
      "request": "attach",
      "port": 8088
    },
    {
      "name": "dartnative_go",
      "request": "launch",
      "type": "dart",
      "args": ["--no-pub"]
    },
    {
      "name": "dartnative_go --no-build",
      "request": "launch",
      "type": "dart",
      "args": ["--no-pub", "--use-application-binary=/Users/mac/Dev/projects/dartnative_go/build/ios/Debug-iphoneos/Runner.app"]
    },
    {
      "name": "dartnative_go (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "dartnative_go (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": ["--no-pub", "--no-build"]
    }
  ]
}
